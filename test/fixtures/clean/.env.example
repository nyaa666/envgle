# Copy this file to .env and adjust the values. Every variable the application
# reads is listed here, and every entry has a comment above it.

# Human-readable name of the service, shown in logs and page titles.
APP_NAME=example-web

# Port the HTTP server listens on.
PORT=3000

# Logging verbosity: debug, info, warn or error.
LOG_LEVEL=info

# Base URL of the backend API, without a trailing slash.
BACKEND_URL=https://api.example.com

# Comma-separated list of feature flags to enable.
FEATURE_FLAGS=checkout,search

# Outbound HTTP timeout in milliseconds.
REQUEST_TIMEOUT_MS=5000

# Token the release job authenticates with. The CI platform injects it.
DEPLOY_TOKEN=
