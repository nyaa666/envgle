# Laravel reads this file. Values are quoted because the parser is strict, and
# APP_ENV=local turns the debug stack on for every deployment that sources it.
APP_NAME="Example"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL="http://localhost"

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=example
DB_USERNAME=example
DB_PASSWORD=secret

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
