# Loaded by the dotenv gem. The export prefix and the single quotes are both
# habits carried over from shell-style .env files, and RAILS_ENV=development
# turns the debug stack on for every deployment that sources this file.
export RAILS_ENV=development
export SECRET_KEY_BASE='not-a-real-key'
export REDIS_URL='redis://localhost:6379/0'
DATABASE_URL='postgres://localhost:5432/rails_app'
PORT=3000
