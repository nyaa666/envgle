# Deliberately awkward: quoted values, values that look like syntax, a bare
# key, a YAML-style line, invalid names and a hostile name, all in one file.
PLAIN_KEY=plain-value
QUOTED_KEY="quoted value"
HASH_IN_VALUE=abc # trailing comment
EQUALS_IN_VALUE=key=value
EXPANDED=${PLAIN_KEY}-suffix
SHARED_WITH_BOM=from-crlf-file
DUPLICATE_KEY=first
DUPLICATE_KEY=second
BARE_KEY
YAML_STYLE_KEY: yaml value
key-with-dash=1
lower_case=1
9LEADING=1
DATABASE_É=1
PATH=/usr/local/bin:/usr/bin
NODE_OPTIONS=--experimental-vm-modules
LANG=en_US.UTF-8
UNTERMINATED="never closed
	INDENTED_TAB=1

# A blank line above, and a last key below it.
LAST_KEY=last-value
